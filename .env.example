# Crime Compass 🧭 — Production & Development Environment Configuration Template
# Copy this file to .env and adjust variables as required.

# Server Port & Host Binding (Cloud hosts automatically inject PORT)
PORT=8000
HOST=0.0.0.0
DEBUG=0

# Security & CORS Settings
# For local development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# For production (set to your deployed frontend domain):
# CORS_ORIGINS=https://crime-compass.vercel.app

# Credentials handling:
# Automatically set to False when CORS_ORIGINS=* and True for explicit domains
CORS_ALLOW_CREDENTIALS=true
